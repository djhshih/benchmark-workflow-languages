configfile: "config.yaml"

rule all:
    input:
        expand("{sample}_counts.txt", sample=config["samples"])

rule trimmomatic:
    input:
        r1=lambda wildcards: config["reads"][wildcards.sample].split()[0],
        r2=lambda wildcards: config["reads"][wildcards.sample].split()[1],
        adapters=config["adapters"]
    output:
        r1_pe="{sample}_R1.trimmed.fastq.gz",
        r2_pe="{sample}_R2.trimmed.fastq.gz",
        r1_se="{sample}_R1.unpaired.fastq.gz",
        r2_se="{sample}_R2.unpaired.fastq.gz"
    threads: 2
    resources:
        mem_mb=4096
        disk_mb=5120
    container: "quay.io/biocontainers/trimmomatic:0.39--hdfd78af_7"
    shell:
        "trimmomatic PE "
        "-threads {threads} "
        "{input.r1} {input.r2} "
        "{output.r1_pe} {output.r1_se} "
        "{output.r2_pe} {output.r2_se} "
        "ILLUMINACLIP:{input.adapters}:2:30:10 "
        "LEADING:3 TRAILING:3 SLIDINGWINDOW:4:15 MINLEN:36"

rule star:
    input:
        r1="{sample}_R1.trimmed.fastq.gz",
        r2="{sample}_R2.trimmed.fastq.gz",
        index_dir=config["reference_index"],
        fasta=config["reference_fasta"]
    output:
        bam="star_{sample}/Aligned.sortedByCoord.out.bam",
        log="star_{sample}/Log.final.out"
    params:
        rg=lambda wildcards: "ID:{wildcards.sample}\\tLB:{wildcards.sample}\\tPL:ILLUMINA\\tSM:{wildcards.sample}"
    threads: 8
    resources:
        mem_mb=32768
        disk_mb=20480
    container: "quay.io/biocontainers/star:2.7.3a--0"
    shell:
        "mkdir -p star_{wildcards.sample} && "
        "STAR "
        "--runMode alignReads "
        "--genomeDir {input.index_dir} "
        "--readFilesIn {input.r1} {input.r2} "
        "--readFilesCommand zcat "
        "--runThreadN {threads} "
        "--outFileNamePrefix star_{wildcards.sample}/ "
        "--outSAMtype BAM SortedByCoordinate "
        "--outBAMcompression 1 "
        "--outSAMunmapped Within KeepPairs "
        "--twopassMode Basic "
        "--outSAMattrRGline {params.rg}"

rule fastqc:
    input:
        r1="{sample}_R1.trimmed.fastq.gz",
        r2="{sample}_R2.trimmed.fastq.gz"
    output:
        html="fastqc_{sample}/{sample}_R1.trimmed_fastqc.html",
        zip="fastqc_{sample}/{sample}_R1.trimmed_fastqc.zip"
    threads: 2
    resources:
        mem_mb=4096
        disk_mb=2048
    container: "quay.io/biocontainers/fastqc:0.11.9--0"
    shell:
        "mkdir -p fastqc_{wildcards.sample} && "
        "fastqc --outdir fastqc_{wildcards.sample} --threads {threads} {input.r1} {input.r2}"

rule featurecounts:
    input:
        bam="star_{sample}/Aligned.sortedByCoord.out.bam",
        annotation=config["annotation"]
    output:
        counts="{sample}_counts.txt",
        summary="{sample}_counts.txt.summary"
    params:
        stranded=lambda wildcards: "1" if config.get("strandedness") == "YES" else "2" if config.get("strandedness") == "REVERSE" else "0"
    threads: 4
    resources:
        mem_mb=8192
        disk_mb=5120
    container: "quay.io/biocontainers/subread:2.0.1--hed695b0_0"
    shell:
        "featureCounts "
        "-T {threads} "
        "-a {input.annotation} "
        "-s {params.stranded} "
        "-o {output.counts} "
        "{input.bam}"
