configfile: "config.yaml"

rule all:
    input:
        expand("{sample}_counts.txt", sample=config["samples"])

rule trimmomatic:
    input:
        reads=lambda wildcards: expand("{sample}_R1.fastq.gz", sample=config["samples"]),
        adapters=config["adapters"]
    output:
        ["{sample}_trimmed_R1.fastq.gz", "{sample}_trimmed_R2.fastq.gz"]
    resources:
        cpu=2,
        mem_mb=4096,
        disk_mb=1024
    shell:
        "java -jar trimmomatic.jar PE {input.reads[0]} {input.reads[1]} {output[0]} {output[1]} ILLUMINACLIP:{input.adapters}:2:30:10"

rule star:
    input:
        reads=lambda wildcards: [f"{wildcards.sample}_trimmed_R1.fastq.gz", f"{wildcards.sample}_trimmed_R2.fastq.gz"],
        reference_index=config["reference_index"]
    output:
        "{sample}_alignment.bam"
    resources:
        cpu=8,
        mem_mb=32768,
        disk_mb=10240
    shell:
        "STAR --runMode alignReads --runThreadN {resources.cpu} --genomeDir {input.reference_index} --readFilesIn {input.reads[0]} {input.reads[1]} --outFileNamePrefix {wildcards.sample}_"

rule fastqc:
    input:
        reads=lambda wildcards: [f"{wildcards.sample}_trimmed_R1.fastq.gz", f"{wildcards.sample}_trimmed_R2.fastq.gz"]
    output:
        ["{sample}_trimmed_R1_fastqc.html", "{sample}_trimmed_R2_fastqc.html"]
    resources:
        cpu=2,
        mem_mb=4096,
        disk_mb=512
    shell:
        "fastqc --outdir . {input.reads[0]} {input.reads[1]}"

rule featurecounts:
    input:
        alignment="{sample}_alignment.bam",
        annotation=config["annotation"]
    output:
        "{sample}_counts.txt"
    resources:
        cpu=4,
        mem_mb=8192,
        disk_mb=1024
    shell:
        "featureCounts -T {resources.cpu} -a {input.annotation} -o {output} {input.alignment}"