configfile: "config.yaml"

rule all:
    input:
        expand("{sample}_cnv.vcf", sample=config["samples"])

rule bwa_mem:
    input:
        reads=lambda wildcards: expand("{sample}_R1.fastq.gz", sample=config["samples"]),
        reference=config["reference"]
    output:
        "{sample}_alignment.sam"
    resources:
        cpu=4,
        mem_mb=8192,
        disk_mb=1024
    shell:
        "bwa mem -t {resources.cpu} {input.reference} {input.reads[0]} {input.reads[1]} > {output}"

rule sort_bam:
    input:
        "{sample}_alignment.sam"
    output:
        "{sample}_sorted.bam"
    resources:
        cpu=2,
        mem_mb=4096,
        disk_mb=1024
    shell:
        "samtools sort -@ {resources.cpu} {input} -o {output}"

rule index_bam:
    input:
        "{sample}_sorted.bam"
    output:
        "{sample}_sorted.bam.bai"
    resources:
        cpu=1,
        mem_mb=2048,
        disk_mb=512
    shell:
        "samtools index {input}"

rule collect_readcounts:
    input:
        bam="{sample}_sorted.bam",
        reference=config["reference"]
    output:
        "{sample}_readcounts.tsv"
    resources:
        cpu=2,
        mem_mb=4096,
        disk_mb=1024
    shell:
        "gatk CollectReadCounts -I {input.bam} -R {input.reference} -O {output}"

rule collect_gc:
    input:
        reference=config["reference"]
    output:
        "gc.tsv"
    resources:
        cpu=1,
        mem_mb=2048,
        disk_mb=512
    shell:
        "gatk CountGC -R {input.reference} -O {output}"

rule denoise_coverage:
    input:
        readcounts="{sample}_readcounts.tsv",
        gc="gc.tsv"
    output:
        "{sample}_denoised.tsv"
    resources:
        cpu=4,
        mem_mb=8192,
        disk_mb=2048
    shell:
        "gatk DenoiseReadCounts --readcounts {input.readcounts} --gc-hdf5 {input.gc} --output-prefix {wildcards.sample}"

rule segment_cnv:
    input:
        "{sample}_denoised.tsv"
    output:
        "{sample}_segments.tsv"
    resources:
        cpu=2,
        mem_mb=4096,
        disk_mb=1024
    shell:
        "gatk SegmentDenoisedCopyRatios --denoised {input} -O {output}"

rule call_cnv:
    input:
        "{sample}_segments.tsv"
    output:
        "{sample}_cnv.vcf"
    resources:
        cpu=2,
        mem_mb=4096,
        disk_mb=1024
    shell:
        "gatk ModelSegments --segments {input} -O {output}"