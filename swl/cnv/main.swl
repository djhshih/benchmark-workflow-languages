# CNV Calling Pipeline in SWL
#
# Import tool definitions
align = import "bwa-mem.sh"
sort = import "sort-bam.sh"
index = import "index-bam.sh"
collect_counts = import "collectreadcounts.sh"
collect_gc = import "collectgc.sh"
denoise = import "denoisecoverage.sh"
segment = import "segmentcnv.sh"
call_cnv = import "callcnv.sh"

# Workflow: align -> sort -> index -> collect_counts + collect_gc -> denoise -> segment -> call_cnv
# Note: collect_counts and collect_gc run in parallel, then both feed into denoise

align | sort | index | collect_counts | collect_gc | denoise | segment | call_cnv